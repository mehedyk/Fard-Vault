# Fard Vault Environment Configuration

# Clerk Authentication Configuration
# Get these from https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# MongoDB Configuration
# Get your connection string from MongoDB Atlas or your self-hosted MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fard_vault?retryWrites=true&w=majority
MONGODB_DB=fard_vault

# App Configuration
VITE_APP_NAME=Fard Vault
VITE_SESSION_TIMEOUT=900000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000

# Zero-Knowledge Argon2id Key Derivation Configuration
VITE_ARGON2_TIME=4
VITE_ARGON2_MEMORY=65536
VITE_ARGON2_PARALLELISM=4

# Companion Tools
VITE_PASSWORD_GENERATOR_URL=https://fard-pw.netlify.app/
